{
    "terminal.integrated.env.windows": {
        "GOEXPERIMENT": "simd",
    },
    "terminal.integrated.env.linux": {
        "GOEXPERIMENT": "simd",
    },
    "terminal.integrated.env.osx": {
        "GOEXPERIMENT": "simd",
    },
    "editor.formatOnSave": true,
    "[markdown]": {
        "editor.wordWrap": "off",
    },
    // Go settings
    "go.delveConfig": {
        "showRegisters": true
    },
    "go.buildTags": "simd_none",
    "gopls": {
        "build.env": {
            "GOEXPERIMENT": "simd",
        },
        "ui.semanticTokens": true,
        "ui.codelenses": {
            "gc_details": true,
            "generate": true
        },
        "ui.diagnostic.analyses": {
            // What the diagnoser needs to check:
            "maprange": true,
            "yield": true,
            "shadow": true,
            "unusedwrite": true,
            "appends": true,
            "atomic": true,
            "bools": true,
            "copylocks": true,
            "defers": true,
            "simplifyslice": true,
            "simplifyrange": true,
            "stdmethods": true,
            "stringintconv": true,
            "errorsas": true
        },
        "ui.diagnostic.analysisProgressReporting": true,
        "ui.diagnostic.annotations": {
            "bounds": true,
            "escape": true,
            "inline": true,
            "nil": true
        },
    },
    // Slice of life hints:
    "go.coverShowCounts": true,
    "go.formatTool": "gofmt",
    "go.inlayHints.compositeLiteralFields": true,
    "go.inlayHints.compositeLiteralTypes": true,
    "go.inlayHints.constantValues": true,
    "go.inlayHints.parameterNames": true,
    "go.languageServerFlags": [
        "-rpc.trace",
        // "-profile.alloc=./gopls/alloc.out",
        // "-profile.cpu=./gopls/cpu.out",
        // "-profile.mem=./gopls/mem.out",
        // "-profile.block=./gopls/block.out",
    ],
    "go.lintOnSave": "workspace",
    "go.lintTool": "golangci-lint-v2",
    "go.lintFlags": [
        "--fix"
    ],
    "go.trace.server": "verbose",
    "go.coverOnSave": true,
    "go.coverageOptions": "showBothCoveredAndUncoveredCode",
    "go.coverMode": "atomic",
    "go.coverageDecorator": {
        "type": "gutter",
        "coveredHighlightColor": "rgba(64,128,128,0.5)",
        "uncoveredHighlightColor": "rgba(128,64,64,0.25)",
        "coveredBorderColor": "rgba(64,128,128,0.5)",
        "uncoveredBorderColor": "rgba(128,64,64,0.25)",
        "coveredGutterStyle": "blockblue",
        "uncoveredGutterStyle": "slashyellow"
    },
    "github.copilot.chat.codeGeneration.useInstructionFiles": true
}